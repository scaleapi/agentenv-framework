:root {
  --bg: #f6f6f3;
  --card: #ffffff;
  --text: #1d1d1b;
  --muted: #6b6b66;
  --line: #deded8;
  --accent: #2f5bd3;
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  color: var(--text);
  background: var(--bg);
}

* { box-sizing: border-box; }
body { margin: 0; }

.bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid var(--line);
  background: var(--card);
}
.bar h1 { margin: 0; font-size: 1.25rem; }
.who { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; color: var(--muted); font-size: 0.9rem; }
.who time { font-variant-numeric: tabular-nums; }

main { max-width: 720px; margin: 0 auto; padding: 16px; }

.card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 12px; }

input, textarea, select, button { font: inherit; color: inherit; }
input, textarea { width: 100%; border: 1px solid var(--line); border-radius: 6px; padding: 6px 8px; background: transparent; }
button { border: 1px solid var(--line); border-radius: 6px; padding: 6px 12px; background: var(--card); cursor: pointer; }
button[type="submit"] { background: var(--accent); border-color: var(--accent); color: #fff; }

form.card { display: flex; gap: 8px; margin-bottom: 16px; }
ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
li small { color: var(--muted); }
li pre { margin: 8px 0 0; white-space: pre-wrap; font-size: 0.85rem; }
li textarea { margin: 8px 0; font-family: ui-monospace, monospace; font-size: 0.85rem; }
.empty { color: var(--muted); text-align: center; padding: 24px; }

#error { color: #b3261e; margin: 0 0 12px; }
