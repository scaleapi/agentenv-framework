# Both of these are OPTIONAL — a fresh clone works with no .env at all.
#
# The dev server proxies /api/v1, /health and /openapi.json to the hub, defaulting to
# the address `agent-env up` binds. Set these only to point somewhere else.

# Where the dev server proxies API calls (server-side only).
# AGENT_ENV_HUB_BACKEND_PROXY_URL=http://127.0.0.1:8234

# Absolute base URL for browser-side calls. Leave unset to use same-origin relative
# paths (recommended — avoids CORS). Set it when the hub is on another origin.
# NEXT_PUBLIC_AGENT_ENV_HUB_BACKEND_URL=
