{
  "name": "agent-env-explorer-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Web UI for the local agent-env explorer (agent-env up).",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "build:static": "NEXT_STATIC_EXPORT=1 next build && cp 'out/[[...slug]].html' out/index.html",
    "test:smoke": "node scripts/run-smokes.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@e965/xlsx": "^0.20.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.2.1",
    "@xyflow/react": "^12.10.2",
    "clsx": "^2.1.1",
    "docx-preview": "0.3.7",
    "jszip": "^3.10.1",
    "lucide-react": "^0.252.0",
    "next": "^15.5.24",
    "pptx-preview": "1.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "uuid": "^11.1.1",
    "echarts": "^6.1.0"
  }
}
