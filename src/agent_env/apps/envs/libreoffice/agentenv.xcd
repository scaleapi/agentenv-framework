<?xml version="1.0" encoding="UTF-8"?>
<!-- agentenv's defaults for LibreOffice on a computer, a layer of its configuration (/etc/libreoffice/registry/) under
     the session user's profile, so every profile starts with them, a reset's fresh one too. They keep it from asking
     anything an agent didn't: no tip of the day, no first-run or new-version bar, no "Get involved" or donation bar,
     no "keep current format" question when it saves in Office's formats, no lock files beside documents (a computer has
     one user, and a stopped app's would ask "Document in use" next time), and no document recovery after the app was
     stopped around a load or a reset. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
<dependency file="main"/>
<oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
 <node oor:name="Misc">
  <prop oor:name="ShowTipOfTheDay" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="FirstRun" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="UseLocking" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="UseDocumentOOoLockFile" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="UseDocumentSystemFileLocking" oor:op="fuse"><value>false</value></prop>
 </node>
 <node oor:name="Save"><node oor:name="Document"><prop oor:name="WarnAlienFormat" oor:op="fuse"><value>false</value></prop></node></node>
</oor:component-data>
<oor:component-data oor:name="Setup" oor:package="org.openoffice">
 <node oor:name="Product">
  <prop oor:name="ooSetupLastVersion" oor:op="fuse"><value>24.2</value></prop>
  <prop oor:name="LastTimeGetInvolvedShown" oor:op="fuse"><value>4102444800</value></prop>
  <prop oor:name="LastTimeDonateShown" oor:op="fuse"><value>4102444800</value></prop>
 </node>
</oor:component-data>
<oor:component-data oor:name="Recovery" oor:package="org.openoffice.Office">
 <node oor:name="RecoveryInfo"><prop oor:name="Enabled" oor:op="fuse"><value>false</value></prop></node>
 <node oor:name="AutoSave"><prop oor:name="Enabled" oor:op="fuse"><value>false</value></prop></node>
</oor:component-data>
</oor:data>
