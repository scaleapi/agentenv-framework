# Build postgres-mcp from source to get streamable-http transport support.
# The Docker Hub image (crystaldba/postgres-mcp:latest) ships MCP 1.6.0,
# which only supports stdio and SSE transports.

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58 AS builder
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
ENV UV_PYTHON_DOWNLOADS=0

WORKDIR /app
RUN apt-get update \
  && apt-get install -y libpq-dev gcc git \
  && rm -rf /var/lib/apt/lists/*
# Pinned, so every build, here or in a VM, builds the same source; move the pin on purpose.
RUN git clone https://github.com/crystaldba/postgres-mcp.git /app \
  && git -C /app checkout --quiet 15c8e33353546148acc2d8bd784551cf3905d1e2

# Patch: disable DNS rebinding protection in FastMCP constructor.
# FastMCP auto-enables it when host="127.0.0.1" (the default), which rejects
# requests arriving through reverse proxies with non-localhost Host headers.
# postgres-mcp creates FastMCP("postgres-mcp") with defaults, then sets
# mcp.settings.host later — but transport_security is already locked in.
RUN sed -i 's/mcp = FastMCP("postgres-mcp")/from mcp.server.transport_security import TransportSecuritySettings\nmcp = FastMCP("postgres-mcp", transport_security=TransportSecuritySettings(enable_dns_rebinding_protection=False))/' /app/src/postgres_mcp/server.py \
  && grep -q "enable_dns_rebinding_protection=False" /app/src/postgres_mcp/server.py

RUN uv sync --frozen --no-dev

FROM public.ecr.aws/docker/library/python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
RUN groupadd -r app && useradd -r -g app app
COPY --from=builder --chown=app:app /app /app

ENV PATH="/app/.venv/bin:$PATH"

RUN apt-get update && apt-get install -y \
  libpq-dev \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

USER app
EXPOSE 8000

ENTRYPOINT ["/app/docker-entrypoint.sh", "postgres-mcp"]
CMD []
