[
  {"id": "env", "type": "deploy_env", "env_id": "desk"},
  {"id": "agent", "type": "deploy_agent", "env_ids": [], "a2a_agent_id": "computer-verifier-echo", "sandbox_type": "local"},
  {"id": "ask", "type": "prompt_agent", "prompt_id": "ask", "depends_on": ["agent"],
   "prompt": "Write ~/Desktop/budget.csv with rent 1200 and food 300 and their total, leave a note in ~/notes.txt, and email the total to ana@example.com."},
  {"id": "work", "type": "computer_exec", "env_id": "desk", "depends_on": ["env"],
   "command": "mkdir -p Desktop Documents && printf 'item,amount\\nrent,1200\\nfood,300\\ntotal,1500\\n' > Desktop/budget.csv && echo 'Budget done: the total is 1500.' > notes.txt && echo '{\"sent\": [{\"to\": \"ana@example.com\", \"subject\": \"Budget\", \"body\": \"The total is 1500.\"}]}' > Documents/outbox.json"},
  {"id": "grade", "type": "computer_verifier", "env_id": "desk", "prompt_id": "ask", "depends_on": ["work", "ask"],
   "verifier_id": "cua", "use_agent_judge": false,
   "instruction": "Write ~/Desktop/budget.csv with rent 1200 and food 300 and their total, leave a note in ~/notes.txt, and email the total to ana@example.com.",
   "result_files": ["~/Desktop/budget.csv", "~/notes.txt"],
   "state_envs": ["desk"],
   "rubric": {"criteria": [
     {"id": "total", "title": "budget.csv has a total row of 1500.", "weight": 50,
      "annotations": {"criteria_type": "REGULAR", "target_result_files": ["budget.csv"]}},
     {"id": "mail", "title": "An email to ana@example.com states the total of 1500.", "weight": 30,
      "annotations": {"criteria_type": "REGULAR"}},
     {"id": "wrong", "title": "Any file or email states a total other than 1500.", "weight": 20,
      "annotations": {"criteria_type": "NEGATIVE"}}]}},
  {"id": "csv", "type": "computer_verifier", "env_id": "desk", "prompt_id": "ask", "depends_on": ["work", "ask"],
   "use_agent_judge": false, "score_aggregator": "all_pass", "result_files": ["~/Desktop/budget.csv"],
   "rubric": [{"id": "csv", "title": "Provides a CSV file at ~/Desktop/budget.csv."}]},
  {"id": "pdf", "type": "computer_verifier", "env_id": "desk", "prompt_id": "ask", "depends_on": ["work", "ask"],
   "use_agent_judge": false, "score_aggregator": "all_pass", "result_files": ["~/Desktop/report.pdf"],
   "rubric": [{"id": "pdf", "title": "Provides a PDF report at ~/Desktop/report.pdf."}]},
  {"id": "final", "type": "aggregate_verifiers", "depends_on": ["grade", "csv"], "sources": ["grade"], "gates": ["csv"]},
  {"id": "gated", "type": "aggregate_verifiers", "depends_on": ["grade", "pdf"], "sources": ["grade"], "gates": ["pdf"]}
]
